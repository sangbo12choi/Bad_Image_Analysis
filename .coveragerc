[run]
source = .
omit = 
    */tests/*
    */test_*.py
    */__pycache__/*
    */venv/*
    */.venv/*
    */setup.py
    */conftest.py
    main.py
    example_usage.py
    organize_images.py
    run_*.py
    setup_folders.py
    */generated_images/*
    */test_results/*
    */output/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

precision = 2
show_missing = True
skip_covered = False

[html]
directory = htmlcov
title = Panel Hard Defect Analysis System - Coverage Report

